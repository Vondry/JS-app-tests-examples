{
  "name": "svelte-app",
  "version": "0.0.1",
  "description": "",
  "author": "Tomas Vondracek",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "lint:check": "npm run lint -- --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "lint": "eslint ./src",
    "format:write": "npm run format -- --write",
    "format:check": "npm run format -- --check",
    "format": "prettier index.html './src/**/*.ts' './src/**/*.svelte' './src/**/*.css'",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "cy:ui": "concurrently -k -s first -n VITE,CYPRESS \"vite --port 8003\" \"cypress open\"",
    "cy": "concurrently -k -s first -n VITE,CYPRESS \"vite --port 8003\" \"cypress run\""
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^2.46.1",
    "prettier-plugin-svelte": "^3.2.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^0.39.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.3.7",
    "@tanstack/svelte-query-devtools": "^6.3.7",
    "svelte-fa": "^4.0.4"
  }
}
