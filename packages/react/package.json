{
  "name": "react-app",
  "version": "0.0.1",
  "description": "",
  "author": "Tomas Vondracek",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:check": "npm run lint -- --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "lint": "eslint ./src",
    "format:write": "npm run format -- --write",
    "format:check": "npm run format -- --check",
    "format": "prettier index.html './src/**/*.ts' './src/**/*.tsx' './src/**/*.css'",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "cy:ui": "concurrently -k -s first -n VITE,CYPRESS \"vite --port 8001\" \"cypress open\"",
    "cy": "concurrently -k -s first -n VITE,CYPRESS \"vite --port 8001\" \"cypress run\""
  },
  "dependencies": {
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-query-devtools": "^5.105.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
